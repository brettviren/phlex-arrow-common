@PACKAGE_INIT@

# phlex_arrow_common: Phlex-aware, technology-agnostic Arrow glue.
# Target: phlex_arrow_common::phlex_arrow_common
# Deps: Apache Arrow (the narrow-waist intermediate) and Phlex >= 0.4.1 (whose
# config finds its own dependencies).  NOT any technology serializer.

include(CMakeFindDependencyMacro)
find_dependency(Arrow)
find_dependency(phlex 0.4.1)

include("${CMAKE_CURRENT_LIST_DIR}/phlex_arrow_commonTargets.cmake")
